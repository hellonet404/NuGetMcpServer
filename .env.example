# Optional host directory containing {PackageId}.{Version}.nupkg files.
NUGET_PACKAGES_PATH=D:/Code/NugetPackages

# Only required when starting with docker-compose.private.yml.
PRIVATE_NUGET_SOURCE_NAME=aliyun-oucp
PRIVATE_NUGET_SERVICE_INDEX_URL=https://packages.example.com/nuget/v3/index.json
PRIVATE_NUGET_USERNAME=replace-me
PRIVATE_NUGET_PASSWORD=replace-me
